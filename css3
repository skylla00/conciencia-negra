/* ==========================================================
   CONSCIÊNCIA NEGRA — Estilo Afro-brasileiro moderno
   Abordagem MOBILE FIRST: o estilo base é o do celular e as
   telas maiores recebem melhorias com @media (min-width).
   ========================================================== */

@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Poppins:wght@300;400;500;600&display=swap');

/* ---------- Variáveis ---------- */
:root {
    --preto: #140d09;
    --marrom-escuro: #2a1810;
    --marrom: #4a2b1a;
    --terracota: #c4511f;
    --laranja: #e8782a;
    --ouro: #f2b632;
    --verde: #1f6b4a;
    --vermelho: #a6281f;
    --creme: #fbf3e4;
    --areia: #f1e2c6;
    --texto: #3a261c;

    --fonte-titulo: 'Playfair Display', Georgia, serif;
    --fonte-corpo: 'Poppins', system-ui, -apple-system, sans-serif;

    /* Faixa inspirada em tecido kente */
    --faixa-kente: linear-gradient(
        90deg,
        var(--ouro) 0 16.66%,
        var(--vermelho) 16.66% 33.33%,
        var(--verde) 33.33% 50%,
        var(--preto) 50% 66.66%,
        var(--terracota) 66.66% 83.33%,
        var(--ouro) 83.33% 100%
    );

    /* Espaçamentos (celular) */
    --lateral: 1.5rem;
    --espaco-secao: 5rem;
    --altura-menu: 3.25rem;
}

/* ---------- Reset ---------- */
*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 106.25%; /* 17px: leitura confortável no celular */
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--altura-menu) + 1rem);
    -webkit-text-size-adjust: 100%;
}

body {
    font-family: var(--fonte-corpo);
    font-weight: 400;
    line-height: 1.75;
    color: var(--texto);
    background: var(--creme);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

::selection {
    background: var(--ouro);
    color: var(--preto);
}

:focus-visible {
    outline: 3px solid var(--ouro);
    outline-offset: 3px;
}

/* ---------- Menu de navegação (compacto) ---------- */
header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(20, 13, 9, 0.96);
    border-bottom: 3px solid transparent;
    border-image: var(--faixa-kente) 1;
    padding-inline: env(safe-area-inset-left) env(safe-area-inset-right);
}

nav {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.35rem 0.75rem;
}

nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* área mínima de toque recomendada */
    color: var(--areia);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 0.8rem;
    border-radius: 999px;
    transition: color 0.3s ease, background 0.3s ease;
}

nav a:hover,
nav a:focus-visible {
    color: var(--preto);
    background: var(--ouro);
}

/* ---------- Banner inicial ---------- */
main#home {
    position: relative;
    min-height: calc(100vh - var(--altura-menu));
    min-height: calc(100svh - var(--altura-menu));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem var(--lateral) 5rem;
    color: var(--creme);
    overflow: hidden;
    background:
        radial-gradient(circle at 20% 25%, rgba(242, 182, 50, 0.28), transparent 45%),
        radial-gradient(circle at 85% 80%, rgba(196, 81, 31, 0.35), transparent 50%),
        linear-gradient(160deg, var(--preto) 0%, var(--marrom-escuro) 55%, #3b1d12 100%);
}

/* Padrão geométrico (losangos) ao fundo */
main#home::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image:
        linear-gradient(45deg, var(--ouro) 25%, transparent 25%),
        linear-gradient(-45deg, var(--ouro) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, var(--ouro) 75%),
        linear-gradient(-45deg, transparent 75%, var(--ouro) 75%);
    background-size: 48px 48px;
    background-position: 0 0, 0 24px, 24px -24px, -24px 0;
    -webkit-mask-image: radial-gradient(circle at center, transparent 20%, #000 90%);
    mask-image: radial-gradient(circle at center, transparent 20%, #000 90%);
}

/* Círculo dourado decorativo (sol) */
main#home::after {
    content: "";
    position: absolute;
    width: 22rem;
    height: 22rem;
    border-radius: 50%;
    border: 2px dashed rgba(242, 182, 50, 0.35);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: girar 60s linear infinite;
    pointer-events: none;
}

main#home h1,
main#home p {
    position: relative;
    z-index: 1;
}

main#home h1 {
    font-family: var(--fonte-titulo);
    font-weight: 900;
    font-size: clamp(3.1rem, 15vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    background: linear-gradient(100deg, var(--ouro), var(--laranja) 50%, var(--ouro));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    margin-bottom: 1.5rem;
    animation: surgir 1s ease both;
}

main#home h1::after {
    content: "";
    display: block;
    width: 110px;
    height: 8px;
    margin: 1.6rem auto 0;
    border-radius: 4px;
    background: var(--faixa-kente);
}

main#home p {
    max-width: 30ch;
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--areia);
    animation: surgir 1s 0.25s ease both;
}

/* ---------- Seções de tema ---------- */
.secao-tema {
    position: relative;
    padding: var(--espaco-secao) var(--lateral);
}

/* Tema 1 — fundo claro */
#tema1 {
    background:
        radial-gradient(circle at 100% 0%, rgba(242, 182, 50, 0.18), transparent 40%),
        var(--creme);
}

/* Tema 2 — fundo escuro, tecnologia */
#tema2 {
    background:
        radial-gradient(circle at 0% 100%, rgba(31, 107, 74, 0.35), transparent 45%),
        radial-gradient(circle at 100% 0%, rgba(196, 81, 31, 0.25), transparent 45%),
        var(--preto);
    color: var(--areia);
}

/* Faixa kente separando as seções */
.secao-tema::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 10px;
    background: var(--faixa-kente);
}

/* Títulos das seções */
.secao-tema h2 {
    font-family: var(--fonte-titulo);
    font-weight: 700;
    font-size: clamp(2rem, 8.5vw, 2.6rem);
    line-height: 1.2;
    text-align: center;
    max-width: 22ch;
    margin: 0 auto 3rem;
    color: var(--marrom);
    text-wrap: balance;
}

#tema2 h2 {
    color: var(--ouro);
}

.secao-tema h2::after {
    content: "";
    display: block;
    width: 90px;
    height: 6px;
    margin: 1.4rem auto 0;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--terracota), var(--ouro), var(--verde));
}

/* ---------- Tópicos (integrados à página, sem cartões) ---------- */
.bloco-conteudo {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 0 3rem;
}

.bloco-conteudo + .bloco-conteudo {
    padding-top: 3rem;
    border-top: 1px solid rgba(74, 43, 26, 0.2);
}

.bloco-conteudo:last-child {
    padding-bottom: 0;
}

#tema2 .bloco-conteudo + .bloco-conteudo {
    border-top-color: rgba(242, 182, 50, 0.25);
}

.bloco-conteudo h3 {
    position: relative;
    font-family: var(--fonte-titulo);
    font-weight: 700;
    font-size: 1.65rem;
    line-height: 1.25;
    color: var(--terracota);
    margin-bottom: 1.4rem;
    padding-bottom: 1rem;
}

.bloco-conteudo h3::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 70px;
    height: 4px;
    border-radius: 2px;
    background: var(--ouro);
}

#tema2 .bloco-conteudo h3 {
    color: var(--laranja);
}

.bloco-conteudo p {
    font-size: 1.1rem;
    line-height: 1.8;
    text-align: left;
}

#tema2 .bloco-conteudo p {
    color: #eadcc3;
}

/* ---------- Rodapé (compacto) ---------- */
footer {
    position: relative;
    text-align: center;
    padding: 1.6rem var(--lateral) calc(1.4rem + env(safe-area-inset-bottom));
    background: var(--marrom-escuro);
    color: var(--areia);
    font-size: 0.78rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
}

footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--faixa-kente);
}

footer p {
    opacity: 0.9;
}

/* ---------- Animações ---------- */
@keyframes surgir {
    from {
        opacity: 0;
        transform: translateY(28px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes girar {
    to {
        transform: translate(-50%, -50%) rotate(360deg);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
    }
}

/* ==========================================================
   TABLET — a partir de 600px
   ========================================================== */
@media (min-width: 600px) {
    :root {
        --lateral: 2.5rem;
        --espaco-secao: 6rem;
        --altura-menu: 3.5rem;
    }

    header {
        background: rgba(20, 13, 9, 0.88);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    nav {
        gap: 0.5rem;
    }

    nav a {
        font-size: 0.82rem;
        padding: 0 1.1rem;
    }

    main#home::before {
        background-size: 60px 60px;
        background-position: 0 0, 0 30px, 30px -30px, -30px 0;
    }

    main#home::after {
        width: 34rem;
        height: 34rem;
    }

    main#home h1 {
        font-size: clamp(4.5rem, 11vw, 6rem);
    }

    main#home p {
        max-width: 36ch;
        font-size: 1.5rem;
    }

    .secao-tema h2 {
        font-size: clamp(2.4rem, 5.5vw, 3rem);
        max-width: 24ch;
        margin-bottom: 3.5rem;
    }

    .bloco-conteudo h3 {
        font-size: 1.9rem;
    }

    footer {
        font-size: 0.82rem;
    }
}

/* ==========================================================
   DESKTOP — a partir de 960px
   ========================================================== */
@media (min-width: 960px) {
    :root {
        --lateral: 4rem;
        --espaco-secao: 7.5rem;
    }

    html {
        font-size: 112.5%; /* 18px */
    }

    main#home h1 {
        font-size: clamp(6rem, 9vw, 7.5rem);
    }

    main#home p {
        max-width: 40ch;
        font-size: 1.6rem;
    }

    .secao-tema h2 {
        max-width: 26ch;
        font-size: 3.2rem;
        margin-bottom: 4.5rem;
    }

    .bloco-conteudo {
        max-width: 46rem;
        padding-bottom: 3.5rem;
    }

    .bloco-conteudo + .bloco-conteudo {
        padding-top: 3.5rem;
    }

    .bloco-conteudo h3 {
        font-size: 2.1rem;
    }

    .bloco-conteudo p {
        font-size: 1.1rem;
        text-align: justify;
        hyphens: auto;
    }
}

/* ==========================================================
   TELAS GRANDES — a partir de 1400px
   ========================================================== */
@media (min-width: 1400px) {
    .bloco-conteudo {
        max-width: 50rem;
    }
}